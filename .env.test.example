# Test credentials — copy to .env.test (gitignored). STAGING ONLY.
#
# Every test layer (integration, e2e, rls) reads these and refuses to run when
# the URL is the production project or the project in .env.local.
# Unit tests (npm run test:unit) need none of this.

# Staging project: tablefront-reservations-staging (ref zbzrbodraecmihzdvvot)
TEST_SUPABASE_URL=https://zbzrbodraecmihzdvvot.supabase.co

# Dashboard → Project Settings → API Keys of the STAGING project.
# Optional locally: when empty and the Supabase CLI is logged in, the keys are
# fetched in-process (`supabase projects api-keys`) and never written to disk.
# Required in CI (set them as repository secrets).
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Optional knobs
# TEST_SUPABASE_KEYS_FROM_CLI=0            disable the CLI fallback above
# TEST_SUPABASE_PRODUCTION_REFS=ref1,ref2  extra project refs to block
# TEST_SUPABASE_ALLOW_ENV_LOCAL_REF=1      allow the ref .env.local points at
# E2E_BASE_URL=http://localhost:3100       e2e: test an already running app instead of starting one
